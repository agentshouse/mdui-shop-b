    "build": "node scripts/prepare-release.mjs && vite build && node scripts/generate-notices.mjs",
    "release:check": "node scripts/check-release.mjs",
    "test:startup": "node --experimental-vm-modules --disallow-code-generation-from-strings scripts/check-sandbox-startup.mjs",
    "publish": "node publish.mjs",
    "verify": "npm run typecheck && npm run lint && npm test -- --maxWorkers=2 && npm run build && npm run release:check && npm run test:startup && npm run starter:check",
    "starter:check": "node scripts/check-starter.mjs"
  },
